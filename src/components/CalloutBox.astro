---
interface Props {
  type?: 'info' | 'warning' | 'error' | 'tip' | 'insight' | 'stat' | 'note' | 'success' | 'next';
  title?: string;
}

const { 
  type = 'info',
  title 
} = Astro.props;

// Set colors based on type. Dark variants use -950 backgrounds and lighter
// foreground tints so the callout remains legible without blowing out.
const bgColor = {
  info: "bg-blue-50 dark:bg-blue-950",
  warning: "bg-yellow-50 dark:bg-yellow-950",
  error: "bg-red-50 dark:bg-red-950",
  tip: "bg-green-50 dark:bg-green-950",
  insight: "bg-purple-50 dark:bg-purple-950",
  stat: "bg-cyan-50 dark:bg-cyan-950",
  note: "bg-gray-50 dark:bg-gray-800",
  success: "bg-emerald-50 dark:bg-emerald-950",
  next: "bg-indigo-50 dark:bg-indigo-950"
}[type];

const borderColor = {
  info: "border-blue-600 dark:border-blue-400",
  warning: "border-yellow-700 dark:border-yellow-400",
  error: "border-red-700 dark:border-red-400",
  tip: "border-green-700 dark:border-green-400",
  insight: "border-purple-700 dark:border-purple-400",
  stat: "border-cyan-700 dark:border-cyan-400",
  note: "border-gray-700 dark:border-gray-500",
  success: "border-emerald-700 dark:border-emerald-400",
  next: "border-indigo-700 dark:border-indigo-400"
}[type];

const textColor = {
  info: "text-blue-900 dark:text-blue-100",
  warning: "text-yellow-900 dark:text-yellow-100",
  error: "text-red-900 dark:text-red-100",
  tip: "text-green-900 dark:text-green-100",
  insight: "text-purple-900 dark:text-purple-100",
  stat: "text-cyan-900 dark:text-cyan-100",
  note: "text-gray-900 dark:text-gray-100",
  success: "text-emerald-900 dark:text-emerald-100",
  next: "text-indigo-900 dark:text-indigo-100"
}[type];

const iconColor = {
  info: "text-blue-700 dark:text-blue-300",
  warning: "text-yellow-700 dark:text-yellow-300",
  error: "text-red-700 dark:text-red-300",
  tip: "text-green-700 dark:text-green-300",
  insight: "text-purple-700 dark:text-purple-300",
  stat: "text-cyan-700 dark:text-cyan-300",
  note: "text-gray-700 dark:text-gray-300",
  success: "text-emerald-700 dark:text-emerald-300",
  next: "text-indigo-700 dark:text-indigo-300"
}[type];

// Set icon based on type
let icon = '';
switch(type) {
  case 'info':
    icon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2h-1V9z" clip-rule="evenodd" />
            </svg>`;
    break;
  case 'warning':
    icon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
            </svg>`;
    break;
  case 'error':
    icon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
            </svg>`;
    break;  case 'tip':
    icon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M11 3a1 1 0 10-2 0v1a1 1 0 102 0V3zM15.657 5.757a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zM5 10a1 1 0 01-1 1H3a1 1 0 110-2h1a1 1 0 011 1zM8 16v-1h4v1a2 2 0 11-4 0zM12 14c.015-.34.208-.646.477-.859a4 4 0 10-4.954 0c.27.213.462.519.476.859h4.002z" />
            </svg>`;
    break;  case 'insight':
    icon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M11 3a1 1 0 10-2 0v1a1 1 0 102 0V3zM15.657 5.757a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zM5 10a1 1 0 01-1 1H3a1 1 0 110-2h1a1 1 0 011 1zM8 16v-1h4v1a2 2 0 11-4 0zM12 14c.015-.34.208-.646.477-.859a4 4 0 10-4.954 0c.27.213.462.519.476.859h4.002z" />
            </svg>`;
    break;
  case 'stat':
    icon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M2 11a1 1 0 011-1h2a1 1 0 011 1v5a1 1 0 01-1 1H3a1 1 0 01-1-1v-5zM8 7a1 1 0 011-1h2a1 1 0 011 1v9a1 1 0 01-1 1H9a1 1 0 01-1-1V7zM14 4a1 1 0 011-1h2a1 1 0 011 1v12a1 1 0 01-1 1h-2a1 1 0 01-1-1V4z" />
            </svg>`;
    break;
  case 'note':
    icon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd" />
            </svg>`;
    break;
  case 'success':
    icon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>`;
    break;
  case 'next':
    icon = `<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
            </svg>`;
    break;
}

const defaultTitle = {
  info: 'Information',
  warning: 'Warning',
  error: 'Error',
  tip: 'Tip',
  insight: 'Insight',
  stat: 'Statistic',
  note: 'Note',
  success: 'Success',
  next: 'Next Steps'
}[type];
---

<div class={`callout-box ${bgColor} border-l-4 ${borderColor} p-4 mb-4 mt-4 rounded-md`}>
  <div class="flex">
    <div class={`flex-shrink-0 ${iconColor}`} set:html={icon} />
    <div class="ml-3">
      {(title || defaultTitle) && (
        <h3 class={`text-sm font-medium ${textColor}`}>
          {title || defaultTitle}
        </h3>
      )}
      <div class={`mt-2 text-sm ${textColor}`}>
        <slot />
      </div>
    </div>
  </div>
</div>
