---
interface Props {
  data: any;
  title?: string;
  description?: string;
  dataSource?: string;
  isIllustrative?: boolean;
  methodology?: string;
  rawDataTitle?: string;
  children?: any;
}

const {
  data,
  title,
  description,
  dataSource,
  isIllustrative = false,
  methodology,
  rawDataTitle = "Raw Data",
  children
} = Astro.props;

const chartId = `chart-${Math.random().toString(36).substring(2, 9)}`;
const drawerId = `drawer-${chartId}`;
---

<figure class="chart-with-data mb-8">
  {title && <h3 class="text-lg font-semibold mb-2">{title}</h3>}
  {description && <p class="text-gray-600 dark:text-gray-300 text-sm mb-4">{description}</p>}
  
  <!-- Chart Container -->
  <div class="chart-container">
    <slot />
  </div>
  
  <!-- Data Source and Transparency Info -->
  <div class="mt-4 space-y-2">
    {isIllustrative && (
      <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3">
        <div class="flex items-center">
          <svg class="w-5 h-5 text-yellow-600 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
          </svg>
          <span class="text-sm font-medium text-yellow-800">Illustrative Data</span>
        </div>
        <p class="text-xs text-yellow-700 mt-1">This chart uses conceptual data for educational purposes. Values are representative of patterns discussed in research but are not from a specific study.</p>
      </div>
    )}
    
    {dataSource && (
      <div class="text-xs text-gray-500 dark:text-gray-400">
        <strong>Data Source:</strong> {dataSource}
      </div>
    )}
    
    {methodology && (
      <div class="text-xs text-gray-500 dark:text-gray-400">
        <strong>Methodology:</strong> {methodology}
      </div>
    )}
    
    <!-- Data Drawer Toggle -->
    <button 
      id={`toggle-${drawerId}`}
      class="inline-flex items-center text-sm text-blue-600 hover:text-blue-800 font-medium"
      onclick={`document.getElementById('${drawerId}').classList.toggle('hidden')`}
    >
      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
      </svg>
      View {rawDataTitle}
    </button>
    
    <!-- Data Drawer -->
    <div id={drawerId} class="hidden mt-3 bg-gray-50 border border-gray-200 rounded-lg p-4">
      <h4 class="text-sm font-semibold text-gray-800 dark:text-gray-100 mb-3">{rawDataTitle}</h4>
      <div class="text-xs font-mono bg-white border border-gray-300 rounded p-3 overflow-auto max-h-96">
        <pre>{JSON.stringify(data, null, 2)}</pre>
      </div>
    </div>
  </div>
</figure>

<style>
  .chart-container {
    position: relative;
  }
  
  pre {
    white-space: pre-wrap;
    word-wrap: break-word;
  }
</style>
