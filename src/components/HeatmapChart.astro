---
interface HeatmapData {
  xLabels: string[];
  yLabels: string[];
  data: number[][];
  colorScale?: [string, string];
}

interface Props {
  data: HeatmapData;
  title?: string;
  description?: string;
  height?: number;
  width?: number;
  id?: string;
}

const {
  data,
  title,
  description,
  height = 400,
  width = 600,
  id = `heatmap-${Math.random().toString(36).substring(2, 9)}`
} = Astro.props;

const heatmapData = JSON.stringify(data);
---

<figure class="heatmap-container mb-8">
  {title && <h3 class="text-lg font-semibold mb-2">{title}</h3>}
  {description && <p class="text-gray-600 dark:text-gray-300 text-sm mb-4">{description}</p>}
  
  <div class="bg-white p-4 border border-gray-200 rounded-lg shadow-sm" style={`height: ${height}px; width: ${width}px; margin: 0 auto;`}>
    <div id={id} class="w-full h-full"></div>
  </div>
  
  <script is:inline src="https://cdn.jsdelivr.net/npm/d3@7"></script>
  
  <script define:vars={{ id, heatmapData }}>
    function initializeHeatmap() {
      if (typeof d3 === 'undefined') {
        setTimeout(initializeHeatmap, 100);
        return;
      }
      
      try {
        const container = document.getElementById(id);
        const data = JSON.parse(heatmapData);
        
        container.innerHTML = '';
        
        const margin = { top: 50, right: 80, bottom: 80, left: 80 };
        const width = container.offsetWidth - margin.left - margin.right;
        const height = container.offsetHeight - margin.top - margin.bottom;
        
        const svg = d3.select(container)
          .append('svg')
          .attr('width', width + margin.left + margin.right)
          .attr('height', height + margin.top + margin.bottom);
        
        const g = svg.append('g')
          .attr('transform', `translate(${margin.left},${margin.top})`);
        
        // Calculate cell dimensions
        const cellWidth = width / data.xLabels.length;
        const cellHeight = height / data.yLabels.length;
        
        // Create scales
        const xScale = d3.scaleBand()
          .domain(data.xLabels)
          .range([0, width])
          .padding(0.1);
        
        const yScale = d3.scaleBand()
          .domain(data.yLabels)
          .range([0, height])
          .padding(0.1);
        
        // Find min and max values for color scale
        const allValues = data.data.flat();
        const minValue = d3.min(allValues);
        const maxValue = d3.max(allValues);
        
        const colorScale = d3.scaleSequential()
          .domain([minValue, maxValue])
          .interpolator(d3.interpolateRdYlBu);
        
        // Create heatmap cells
        data.yLabels.forEach((yLabel, i) => {
          data.xLabels.forEach((xLabel, j) => {
            const value = data.data[i][j];
            
            g.append('rect')
              .attr('x', xScale(xLabel))
              .attr('y', yScale(yLabel))
              .attr('width', xScale.bandwidth())
              .attr('height', yScale.bandwidth())
              .attr('fill', colorScale(value))
              .attr('stroke', 'white')
              .attr('stroke-width', 1)
              .on('mouseover', function(event) {
                const tooltip = d3.select('body')
                  .append('div')
                  .attr('class', 'tooltip')
                  .style('opacity', 0)
                  .style('position', 'absolute')
                  .style('background', 'rgba(0,0,0,0.8)')
                  .style('color', 'white')
                  .style('padding', '8px')
                  .style('border-radius', '4px')
                  .style('font-size', '12px')
                  .style('pointer-events', 'none');
                
                tooltip.transition()
                  .duration(200)
                  .style('opacity', .9);
                
                tooltip.html(`${xLabel} × ${yLabel}<br/>Value: ${value}`)
                  .style('left', (event.pageX + 10) + 'px')
                  .style('top', (event.pageY - 28) + 'px');
              })
              .on('mouseout', function() {
                d3.selectAll('.tooltip').remove();
              });
            
            // Add text labels if values are readable
            if (xScale.bandwidth() > 30 && yScale.bandwidth() > 20) {
              g.append('text')
                .attr('x', xScale(xLabel) + xScale.bandwidth() / 2)
                .attr('y', yScale(yLabel) + yScale.bandwidth() / 2)
                .attr('text-anchor', 'middle')
                .attr('dominant-baseline', 'middle')
                .attr('font-size', '10px')
                .attr('fill', value > (minValue + maxValue) / 2 ? 'white' : 'black')
                .text(value);
            }
          });
        });
        
        // Add axes
        g.append('g')
          .attr('transform', `translate(0,${height})`)
          .call(d3.axisBottom(xScale))
          .selectAll('text')
          .style('text-anchor', 'end')
          .attr('dx', '-.8em')
          .attr('dy', '.15em')
          .attr('transform', 'rotate(-45)');
        
        g.append('g')
          .call(d3.axisLeft(yScale));
        
        console.log(`Heatmap ${id} initialized successfully`);
      } catch (error) {
        console.error('Failed to create heatmap:', error);
        document.getElementById(id).innerHTML = `
          <div class="flex items-center justify-center h-full">
            <div class="text-red-500">Failed to load heatmap. Please try again later.</div>
          </div>
        `;
      }
    }
    
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeHeatmap);
    } else {
      initializeHeatmap();
    }
  </script>
</figure>
